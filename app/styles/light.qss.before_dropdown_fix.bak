QMainWindow,
QWidget {
    background-color: #f4f4f6;
    color: #25262b;
}

/* =========================================================
   SIDEBAR
   ========================================================= */

QWidget#sidebar {
    background-color: #ffffff;
    border-right: 1px solid #dedee3;
}

/* =========================================================
   LABELS
   ========================================================= */

QLabel {
    color: #25262b;
}

QLabel#pageTitle {
    font-size: 30px;
    font-weight: 600;
    color: #25262b;
}

QLabel#readerBookTitle {
    font-size: 20px;
    font-weight: 600;
    color: #25262b;
}

QLabel#sectionTitle {
    font-size: 16px;
    font-weight: 600;
    color: #25262b;
}

QLabel#secondaryLabel {
    color: #70727b;
    font-size: 13px;
}

QLabel#bookTitle {
    font-size: 14px;
    font-weight: 600;
    color: #25262b;
}

QLabel#bookAuthor {
    color: #777983;
    font-size: 12px;
}

/* =========================================================
   BUTTONS
   ========================================================= */

QPushButton {
    background-color: #ffffff;
    color: #25262b;

    border: 1px solid #d2d3d8;
    border-radius: 7px;

    padding: 8px 12px;
}

QPushButton:hover {
    background-color: #eeeeF2;
    border-color: #6b63c7;
}

QPushButton:pressed {
    background-color: #e1e1e7;
}

QPushButton:disabled {
    background-color: #e5e5e8;
    color: #9a9ba2;
    border-color: #d2d3d8;
}

QPushButton#primaryButton {
    background-color: #625ca8;
    color: #ffffff;

    border-color: #625ca8;
}

QPushButton#primaryButton:hover {
    background-color: #554f9c;
}

QPushButton#dangerButton {
    background-color: #ffffff;
    color: #a23f4f;

    border-color: #e0b6bd;
}

QPushButton#dangerButton:hover {
    background-color: #fff0f2;

    border-color: #c95d6e;
}

/* =========================================================
   INPUTS
   ========================================================= */

QLineEdit,
QSpinBox,
QComboBox {
    background-color: #ffffff;
    color: #25262b;

    border: 1px solid #d2d3d8;
    border-radius: 7px;

    padding: 7px;
}

QLineEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border-color: #6b63c7;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #25262b;

    selection-background-color: #6b63c7;
    selection-color: #ffffff;
}

/* =========================================================
   BOOK CARDS
   ========================================================= */

QFrame#bookCard {
    background-color: #ffffff;

    border: 1px solid #dedee3;
    border-radius: 12px;
}

QFrame#bookCard:hover {
    background-color: #fafafe;

    border-color: #6b63c7;
}

QLabel#bookCover {
    background-color: #ececf2;

    color: #625ca8;

    border-radius: 8px;

    font-size: 22px;
    font-weight: 700;
}

/* =========================================================
   TABLE OF CONTENTS
   ========================================================= */

QFrame#tocPanel {
    background-color: #ffffff;

    border: 1px solid #dedee3;
    border-radius: 8px;
}

QListWidget {
    background-color: #ffffff;
    color: #25262b;

    border: none;

    padding: 4px;
}

QListWidget::item {
    padding: 10px 8px;

    border-radius: 5px;
}

QListWidget::item:hover {
    background-color: #eeeeF2;
}

QListWidget::item:selected {
    background-color: #6b63c7;
    color: #ffffff;
}

/* =========================================================
   SCROLL AREAS
   ========================================================= */

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollBar:vertical {
    background-color: #ececf0;

    width: 10px;
}

QScrollBar::handle:vertical {
    background-color: #b3b4bc;

    min-height: 30px;

    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9697a0;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* =========================================================
   DIALOGS
   ========================================================= */

QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #25262b;
}

QToolTip {
    background-color: #ffffff;
    color: #25262b;

    border: 1px solid #d2d3d8;
}